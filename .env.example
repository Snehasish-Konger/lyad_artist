# ---------------------------------------------------------------------------
# Email (required for the commission + contact forms to actually send)
# ---------------------------------------------------------------------------
# 1. Create a free account at https://resend.com
# 2. Verify the domain snehasishkonger.com (Domains -> Add Domain -> add DNS records)
# 3. Create an API key and paste it below.
RESEND_API_KEY=

# The address form submissions are sent TO.
STUDIO_EMAIL=studio@snehasishkonger.com

# The address form submissions are sent FROM. Must be on a domain you have
# verified in Resend. Until you verify a domain you can use onboarding@resend.dev
# for testing (it will only deliver to the email you signed up with).
MAIL_FROM="Snehasish Konger Studio <studio@snehasishkonger.com>"

# ---------------------------------------------------------------------------
# Google Sheets (the permanent log every commission + question is appended to)
# ---------------------------------------------------------------------------
# Full walkthrough in README.md — the short version:
# 1. Google Cloud Console -> new project -> enable the "Google Sheets API".
# 2. IAM & Admin -> Service Accounts -> create one -> Keys -> Add key -> JSON.
# 3. Open the downloaded JSON: "client_email" -> GOOGLE_SERVICE_ACCOUNT_EMAIL,
#    "private_key" -> GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY (keep the quotes and
#    the \n sequences exactly as they appear in the file).
# 4. Open the Sheet itself and Share it with that client_email as an Editor —
#    this step is manual and can't be done from code.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# The sheet everything gets appended to. Defaults to the one already set up —
# only change this if you're pointing at a different spreadsheet.
GOOGLE_SHEET_ID=1S4FTFyrOzhGefyIGg2WkYuWrkBQ1kaHMo8J0Ih2k0m0

# ---------------------------------------------------------------------------
# Instagram feed (optional — the site falls back to a curated grid without it)
# ---------------------------------------------------------------------------
# Recommended: Behold.so (https://behold.so). Free tier, no OAuth on your side.
# Create a feed for @lyad_artist, then copy the "JSON feed" ID from the dashboard.
# The site fetches it server-side and renders posts in its own styling.
NEXT_PUBLIC_BEHOLD_FEED_ID=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# This site IS snehasishkonger.com — there is no separate storefront domain.
NEXT_PUBLIC_SITE_URL=https://snehasishkonger.com
