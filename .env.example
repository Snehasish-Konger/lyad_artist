# ---------------------------------------------------------------------------
# Email (required for the commission + contact forms to actually send)
# ---------------------------------------------------------------------------
# Sent via the studio's own Hostinger mailbox over SMTP — no third-party
# email service needed. Full walkthrough in README.md; short version:
# 1. hPanel -> Emails -> create (or reuse) a mailbox, e.g. studio@snehasishkonger.com,
#    and set its password (this is the MAILBOX password, not your Hostinger
#    account login password).
# 2. hPanel -> Emails -> that mailbox -> Connect Apps & Devices -> note the
#    SMTP host/port shown there (defaults below match Hostinger's usual values).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=studio@snehasishkonger.com
SMTP_PASSWORD=

# The address form submissions are sent TO. Usually the same as SMTP_USER.
STUDIO_EMAIL=studio@snehasishkonger.com

# The address form submissions are sent FROM. Most mail servers (including
# Hostinger's) reject a From address that isn't the authenticated mailbox
# itself, so keep the email part matching SMTP_USER — only the display name
# is really yours to customize here.
MAIL_FROM="S. Konger Arts <studio@snehasishkonger.com>"

# ---------------------------------------------------------------------------
# Google Sheets (the permanent log every commission + question is appended to)
# ---------------------------------------------------------------------------
# Full walkthrough in README.md — the short version:
# 1. Google Cloud Console -> new project -> enable the "Google Sheets API".
# 2. IAM & Admin -> Service Accounts -> create one -> Keys -> Add key -> JSON.
# 3. Open the downloaded JSON: "client_email" -> GOOGLE_SERVICE_ACCOUNT_EMAIL,
#    "private_key" -> GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY (keep the quotes and
#    the \n sequences exactly as they appear in the file).
# 4. Open the Sheet itself and Share it with that client_email as an Editor —
#    this step is manual and can't be done from code.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# The sheet everything gets appended to. Defaults to the one already set up —
# only change this if you're pointing at a different spreadsheet.
GOOGLE_SHEET_ID=1S4FTFyrOzhGefyIGg2WkYuWrkBQ1kaHMo8J0Ih2k0m0

# ---------------------------------------------------------------------------
# WhatsApp (the "Order it" / "Message the studio" CTAs across the site)
# ---------------------------------------------------------------------------
# A studio-only WhatsApp Business number, separate from a personal phone.
# Full international format, digits only — no "+", no spaces, no dashes.
# Leave unset and every WhatsApp CTA on the site simply doesn't render.
NEXT_PUBLIC_STUDIO_WHATSAPP_NUMBER=917428868498

# ---------------------------------------------------------------------------
# Telegram (optional secondary channel, off unless a username is set)
# ---------------------------------------------------------------------------
# t.me also supports a pre-filled message, same as WhatsApp. Set this whenever
# you want a Telegram button to appear next to the WhatsApp one — no code
# change needed either way.
NEXT_PUBLIC_STUDIO_TELEGRAM_USERNAME=

# ---------------------------------------------------------------------------
# Instagram feed (optional — the site falls back to a curated grid without it)
# ---------------------------------------------------------------------------
# Recommended: Behold.so (https://behold.so). Free tier, no OAuth on your side.
# Create a feed for @lyad_artist, then copy the "JSON feed" ID from the dashboard.
# The site fetches it server-side and renders posts in its own styling.
NEXT_PUBLIC_BEHOLD_FEED_ID=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# This site IS snehasishkonger.com — there is no separate storefront domain.
NEXT_PUBLIC_SITE_URL=https://snehasishkonger.com
